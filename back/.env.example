# Puerto del servidor Express
PORT=3001

# Origen permitido por CORS (frontend dev)
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Versión vigente del aviso de privacidad/consentimiento
# Si cambia esta cadena, todos los pacientes deben volver a aceptar
VERSION_AVISO_VIGENTE=2026-11-v1

# Zona horaria de la aplicación (America/Mexico_City)
# La columna tomas.fecha se calcula en esta misma zona; deben coincidir
TZ_APP=America/Mexico_City

